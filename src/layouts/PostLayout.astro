---
import { getCollection } from "astro:content";
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
};

const { site } = config;

const { title, description, ogImage, canonicalURL, pubDatetime, modDatetime } =
  Astro.props;

// 1. Wyciągamy aktualny identyfikator (slug/id) z adresu URL
const currentPath = Astro.url.pathname;
const currentSlug = currentPath.split("/").filter(Boolean).pop();

// 2. Pobieramy wszystkie posty z kolekcji
const allPosts = await getCollection("posts");

// 3. Znajdujemy aktualny post, aby poznać jego tagi
const currentPost = allPosts.find(p => p.id === currentSlug);
const currentTags = currentPost?.data.tags || [];

// 4. Filtrujemy powiązane posty na podstawie wspólnych tagów
const relatedPosts = allPosts
  .filter(p => p.id !== currentSlug && !p.data.draft)
  .map(p => {
    const pTags = p.data.tags || [];
    const commonTagsCount = pTags.filter(tag => currentTags.includes(tag)).length;
    return { post: p, score: commonTagsCount };
  })
  .filter(item => item.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 2)
  .map(item => item.post);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title ?? site.title,
  image: ogImage,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

<slot />

  {relatedPosts.length > 0 && (
    <div class="app-layout">
      <section class="mt-16 border-t border-border pt-8">
        <h3 class="text-xl font-semibold tracking-wide mb-4">Powiązane notatki w ogrodzie</h3>
        <ul class="grid gap-4 sm:grid-cols-2">
          {relatedPosts.map(p => (
            <li>
              <a 
                href={`/posts/${p.id}/`}
                class="block p-4 rounded-lg border border-border bg-muted/20 hover:border-accent transition-all"
              >
                <h4 class="font-medium text-accent hover:underline">{p.data.title}</h4>
                <p class="text-sm text-muted-foreground mt-1 line-clamp-2">{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  )}
</Layout>
