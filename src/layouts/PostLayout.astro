---
import { getCollection } from "astro:content";
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  tags?: string[];
  slug?: string;
};

const { site } = config;

const { title, description, ogImage, canonicalURL, pubDatetime, modDatetime, tags = [], slug } =
  Astro.props;

// Pobieramy wszystkie posty i filtrujemy po wspólnych tagach
const allPosts = await getCollection("posts");
const relatedPosts = allPosts
  .filter(p => p.id !== slug && !p.data.draft)
  .map(p => {
    const pTags = p.data.tags || [];
    const commonTagsCount = pTags.filter(tag => tags.includes(tag)).length;
    return { post: p, score: commonTagsCount };
  })
  .filter(item => item.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 2)
  .map(item => item.post);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title ?? site.title,
  image: ogImage,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};
---
